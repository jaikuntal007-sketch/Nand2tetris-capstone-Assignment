// CPU.hdl - Hack CPU. Roll No 2501730415, K = 15
// Built from Not/And/Or/Mux16 plus the built-in ALU, ARegister, DRegister and PC.
CHIP CPU {
    IN  inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    // bit 15: 0 = A-instruction, 1 = C-instruction
    Not(in=instruction[15], out=isA);
    Or(a=instruction[15], b=false, out=isC);

    // ---- A register ----
    // takes the instruction itself (A-instr) or the ALU result (C-instr with dest A)
    Mux16(a=instruction, b=aluOut, sel=isC, out=aIn);
    And(a=isC, b=instruction[5], out=destA);       // d1
    Or(a=isA, b=destA, out=loadA);
    ARegister(in=aIn, load=loadA, out=aOut, out[0..14]=addressM);

    // ---- D register ----
    And(a=isC, b=instruction[4], out=loadD);       // d2
    DRegister(in=aluOut, load=loadD, out=dOut);

    // ---- ALU: second input is A or M (a-bit = bit 12) ----
    Mux16(a=aOut, b=inM, sel=instruction[12], out=aOrM);
    ALU(x=dOut, y=aOrM,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9],  ny=instruction[8],
        f=instruction[7],   no=instruction[6],
        out=aluOut, out=outM, zr=zr, ng=ng);

    // ---- write to memory: dest bit d3 (bit 3) ----
    And(a=isC, b=instruction[3], out=writeM);

    // ---- jump logic (bits 2,1,0 = JLT, JEQ, JGT) ----
    Or(a=zr, b=ng, out=notPos);
    Not(in=notPos, out=pos);
    And(a=instruction[2], b=ng,  out=jlt);
    And(a=instruction[1], b=zr,  out=jeq);
    And(a=instruction[0], b=pos, out=jgt);
    Or(a=jlt, b=jeq, out=j1);
    Or(a=j1,  b=jgt, out=j2);
    And(a=isC, b=j2, out=jump);

    // ---- program counter: jump -> A, otherwise +1, reset -> 0 ----
    PC(in=aOut, load=jump, inc=true, reset=reset, out[0..14]=pc);
}
