// Memory.hdl - RAM16K (0-16383), Screen (16384-24575), Keyboard (24576)
// Roll No 2501730415, K = 15
CHIP Memory {
    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    // address[14] = 0 -> RAM,  address[14] = 1 -> Screen / Keyboard
    DMux(in=load, sel=address[14], a=loadRam, b=loadScr);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScr, address=address[0..12], out=scrOut);
    Keyboard(out=kbdOut);

    // address[13] = 0 -> Screen, 1 -> Keyboard
    Mux16(a=scrOut, b=kbdOut, sel=address[13], out=hiOut);
    Mux16(a=ramOut, b=hiOut,  sel=address[14], out=out);
}
